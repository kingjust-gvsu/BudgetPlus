# Copy this file to .env and fill in values for your machine.
# .env is git-ignored; never commit real secrets.

# Port the API listens on. The frontend dev server forwards /api here.
PORT=4000

# Origin allowed to call the API from a browser (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection. Replace YOUR_PASSWORD with the password for the
# "postgres" user you chose when installing PostgreSQL.
# The budget_plus database is created automatically by `npm run db:migrate -w backend`.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/budget_plus

# Firebase project ID, used to check sign-in tokens. Find it in the Firebase console
# under Project settings > General. No secret key is needed.
FIREBASE_PROJECT_ID=your-firebase-project-id
