// Database schema for Budget+.
// After changing this file, run `npm run db:migrate -w backend` to update the database.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Bills cost what they cost and are shown neutrally; expenses are choices with a spending limit.
enum CategoryKind {
  BILL
  EXPENSE
}

// How a category's monthly amount is decided. Bills always use FIXED (their estimate).
enum BudgetType {
  FIXED // a set amount: budget_cents
  PERCENT_OF_INCOME // a share of monthly income: budget_percent_hundredths
  REMAINDER // whatever is left after every other category; only one per user
}

// Bank accounts hold money; credit cards hold what you owe; savings funds set money aside for
// something (car insurance, a house).
enum AccountType {
  BANK
  CREDIT_CARD
  FUND
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  // Sign-up and login are handled by Firebase; this links our data to the Firebase account.
  firebaseUid   String         @unique @map("firebase_uid")
  email         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  categories    Category[]
  transactions  Transaction[]
  incomeSources IncomeSource[]
  otherIncome   OtherIncome[]
  accounts      Account[]

  @@map("users")
}

// A bill or expense category. Its name, kind, and bill schedule are the same in every month; its
// budget can change from a month on (see CategoryBudget), so past months keep the budget they had.
model Category {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  name            String
  kind            CategoryKind
  // Bills only: how often it's due (1 = monthly, 6 = every 6 months) and when it's next due
  frequencyMonths Int              @default(1) @map("frequency_months")
  nextDueDate     DateTime?        @map("next_due_date") @db.Date
  createdAt       DateTime         @default(now()) @map("created_at")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  budgets         CategoryBudget[]

  @@unique([userId, name])
  @@map("categories")
}

// A category's budget from `month` (YYYY-MM) on, until a later month changes it. The category
// starts in its first month here; `stopped` means it was removed from that month on.
model CategoryBudget {
  categoryId              String     @map("category_id") @db.Uuid
  month                   String     @db.Char(7)
  stopped                 Boolean    @default(false)
  budgetType              BudgetType @default(FIXED) @map("budget_type")
  // FIXED: the amount in whole cents. For a bill, the estimate for each time it's due.
  budgetCents             Int?       @map("budget_cents")
  // PERCENT_OF_INCOME: the percentage times 100, so 12.5% is 1250 (whole numbers stay exact)
  budgetPercentHundredths Int?       @map("budget_percent_hundredths")
  category                Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, month])
  @@map("category_budgets")
}

model Transaction {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  // Optional so imported transactions can exist before they're categorized.
  categoryId  String?   @map("category_id") @db.Uuid
  // The account the money came out of (or went back into)
  accountId   String    @map("account_id") @db.Uuid
  date        DateTime  @db.Date
  description String
  // Whole cents, never floating point. Positive = money spent, negative = money back (e.g. a refund).
  amountCents Int       @map("amount_cents")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // An account with transactions can't be deleted
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@map("transactions")
}

// A regular source of income, like a job. Its amount carries over from month to month: each month
// uses the most recent amount set in that month or before it.
model IncomeSource {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  name      String
  createdAt DateTime       @default(now()) @map("created_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amounts   IncomeAmount[]

  @@unique([userId, name])
  @@map("income_sources")
}

// An income source's amount from `month` (YYYY-MM) on, until a later month sets a new one
model IncomeAmount {
  sourceId    String       @map("source_id") @db.Uuid
  month       String       @db.Char(7)
  amountCents Int          @map("amount_cents")
  source      IncomeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([sourceId, month])
  @@map("income_amounts")
}

// One-off income for a single month (a bonus, a tax refund). Unlike sources, it doesn't carry over.
model OtherIncome {
  userId      String @map("user_id") @db.Uuid
  month       String @db.Char(7)
  amountCents Int    @map("amount_cents")
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, month])
  @@map("other_income")
}

// Where money is kept: a bank account, a credit card, or a savings fund. Its balance is the starting
// balance plus everything from the start date on. Balances are what you have, so a credit card's
// balance is negative: what you owe.
model Account {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  name                 String
  type                 AccountType
  startingBalanceCents Int           @map("starting_balance_cents")
  // The day the starting balance is from; earlier transactions don't change the balance
  startDate            DateTime      @map("start_date") @db.Date
  createdAt            DateTime      @default(now()) @map("created_at")
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         Transaction[]

  @@unique([userId, name])
  @@map("accounts")
}
