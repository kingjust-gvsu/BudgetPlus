# Copy this file to .env.local and fill in your Firebase web app settings.
# Find them in the Firebase console: Project settings > General > Your apps > Budget+ web.
# These identify the Firebase project; they are not secrets, but .env.local stays out of git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
